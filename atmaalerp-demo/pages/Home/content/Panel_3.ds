<panel elementName='Panel 3'>
							<pr width='fill' height='fill'>
								<pc bgColor='#FFFFFF' width='100%' hAlign='center' vAlign='middle'>
									<pr width='fill' height='fill'>
										<pc padding='20px' width='100%'>
											<pr width='auto' height='auto'>
												<pc>
													<text color='#4C7DE8' size='36px' bold='true' type='Form Data' bgColor='rgba(0, 0, 0, 0)' displayType='actual' decimalPlaces='2' thousandsSeperator='LOCALE' decimalSeperator='DOT' numberScale='none' value='thisapp.Add_Inventory.Unit_Price.avg'>
													</text>

												</pc>
											</pr>
										</pc>
									</pr>
									<pr width='fill' height='fill'>
										<pc paddingTop='17px' paddingLeft='0px' paddingRight='17px' paddingBottom='17px' bgColor='#FAFAFA' width='100%' hAlign='center' vAlign='middle'>
											<pr width='auto' height='auto'>
												<pc>
													<text color='#333333' size='16px' type='Text' bgColor='rgba(0, 0, 0, 0)' value='Avg Unit Price'>
													</text>

												</pc>
											</pr>
										</pc>
									</pr>
								</pc>
							</pr>
</panel>