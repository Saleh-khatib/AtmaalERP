list All_Inventories
{

			displayName = "All Inventories"
			show all rows from Add_Inventory    
			(
				Item_Name as "Item Name"
				(
					width = 160px
				)
				Category
				(
					width = 154px
				)
				Quantity
				(
					width = 107px
				)
				Unit_Price as "Unit Price"
				(
					width = 114px
				)
				Reorder_Level as "Reorder Level"
				(
					width = 167px
				)
				Manufacturer
				(
					width = 166px
				)
				Last_Updated as "Last Updated"
				(
					width = 160px
				)
				Material_Type as "Material Type"
				(
					width = 136px
				)
				Material_Grade as "Material Grade"
				(
					width = 145px
				)
				Lead_Time_days as "Lead Time (days)"
				(
					width = 156px
				)
				Shelf_Life_months as "Shelf Life (months)"
				(
					width = 178px
				)
				Storage_Conditions as "Storage Conditions"
				(
					width = 193px
				)
				Hazards
				(
					width = 122px
				)
			)
		
}