	    form Config_Strings
	    {
	        label placement = top
	    }
	    form Error_Log
	    {
	        label placement = top
	    }
	}
	reports
	{
		report Account_List
		{
		    quickview
		    (
		        layout
		        (
		            type = -1
		            datablock1
		            (
		                layout type = -1
		                fields
		                (
		                    Account_ID
		                    Account_Name
		                )
		            )
		        )
		        menu
		        (
		            header ( Edit  Duplicate  Delete )
		            record ( Edit  Duplicate  Delete )
		        )
		        action
		        (
		            on click ( View Record )
		            on right click ( Edit  Delete  Duplicate  View Record )
		        )
		    )
		    detailview
		    (
		        layout
		        (
		            type = 1
		            datablock1
		            (
		                layout type = -2
		                fields
		                (
