application "Demo 2"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Amman"
	time format = "24-hr"



	forms
	{
		form Account
		{
		    title
		    {
		        displayname = "Account"
		        on add = "Add Account"
		        on edit = "Edit Account"
		    }
		
		    Account_Details
		    (
		        type = section
		        displayname = "Account Details"
		        row = 1
		        column = 0
		    )
		    must have unique Account_ID
		    (
		        type = text
		        displayname = "Account ID"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Account_Name
		    (
		        type = text
		        displayname = "Account Name"
		        row = 1
		        column = 2
		        width = medium
		    )
		
		
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Audit_Log
		{
		    title
		    {
		        displayname = "Audit Log"
		        on add = "Add Audit Log"
		        on edit = "Edit Audit Log"
		    }
		
		    Audit_Details
		    (
		        type = section
		        displayname = "Audit Details"
		        row = 1
		        column = 0
		    )
		    must have Event_Time
		    (
		        type = datetime
		        displayname = "Event Time"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Portal_User
		    (
		        type = picklist
		        displayname = "Portal User"
		        values = Portal_User.ID
		        displayformat = [Full_Name]
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Account_ID
		    (
		        type = text
		        displayname = "Account ID"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Action
		    (
		        type = text
		        displayname = "Action"
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Zoho_Module_Info
		    (
		        type = section
		        displayname = "Zoho Module Information"
		        row = 2
		        column = 0
		        visibility = true
		    )
		    Zoho_Module
		    (
		        type = text
		        displayname = "Zoho Module"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Zoho_Record_ID
		    (
		        type = text
		        displayname = "Zoho Record ID"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Result
		    (
		        type = text
		        displayname = "Result"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Error_Text
		    (
		        type = textarea
		        displayname = "Error Text"
		        row = 2
		        column = 2
		        width = medium
		    )
		
		
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Config_Stage_Map
		{
		    title
		    {
		        displayname = "Config Stage Map"
		        on add = "Add Stage Mapping"
		        on edit = "Edit Stage Mapping"
		    }
		
		    Stage_Mapping
		    (
		        type = section
		        displayname = "Stage Mapping"
		        row = 1
		        column = 0
		    )
		    must have unique CRM_Stage_Value
		    (
		        type = text
		        displayname = "CRM Stage Value"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Client_Label_EN
		    (
		        type = text
		        displayname = "Client Label (English)"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Client_Label_AR
		    (
		        type = text
		        displayname = "Client Label (Arabic)"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Dashboard_Group
		    (
		        type = picklist
		        displayname = "Dashboard Group"
		        values = {"New", "In progress", "Needs your action", "Completed"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Who_Acts
		    (
		        type = picklist
		        displayname = "Who Acts"
		        values = {"Client", "Provider"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    ETA_Text
		    (
		        type = text
		        displayname = "ETA Text"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Sort_Order
		    (
		        type = number
		        displayname = "Sort Order"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Config_Strings
		{
		    title
		    {
		        displayname = "Config Strings"
		        on add = "Add UI String"
		        on edit = "Edit UI String"
		    }
		
		    String_Details
		    (
		        type = section
		        displayname = "String Details"
		        row = 1
		        column = 0
		    )
