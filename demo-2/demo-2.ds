	customize
	{
	
			
			font = "lato"
			color options
	    	{
	        color = "11"
	    	}
	    	icon
	    	{
	        	text = "DEM"
	        	background color = "theme"
	        	foreground color = "#ffffff"
	    	}
	    	logo
	    	{
	        	preference = "app_icon"
	        	placement = "left"
	    	}
		
	}

	share_settings
	{
	"Approver"
	{
	    name        = "Approver"
	    type        = Users_Permissions
	    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
	    description = "External portal user - all Requester permissions plus approve proposals, sign agreements via Zoho Sign, sign off UAT, approve go-live"
	}
	"Requester"
	{
	    name        = "Requester"
	    type        = Users_Permissions
	    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
	    description = "External portal user - can view own company records, create requests, reply, upload documents, raise tickets, download documents, confirm contacts, mark UAT scenarios"
	}
	"Viewer"
	{
	    name        = "Viewer"
	    type        = Users_Permissions
	    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
	    description = "External portal user - read-only access to own company records, can download documents; no action buttons, cannot call write functions"
	}
	roles
	{
	
					"CEO"
					{
						description = "User belonging to this role can access data of all other users."
					}
				
	}
	}

	web
	{
	forms
	{
	    form Account
	    {
	        label placement = top
	    }
	    form Portal_User
	    {
	        label placement = top
	    }
	    form Request_Index
	    {
	        label placement = top
	    }
	    form Notification
	    {
	        label placement = top
	    }
	    form Audit_Log
	    {
	        label placement = top
	    }
	    form Config_Stage_Map
	    {
	        label placement = top
