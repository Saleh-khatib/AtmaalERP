	reports
	{
		list Account_List
		{
		    displayName = "Account List"
		    show all rows from Account
		    (
		        Account_ID
		        Account_Name
		    )
		}

		list Audit_Log_List
		{
		    displayName = "Audit Log List"
		    show all rows from Audit_Log
		    (
		        Event_Time
		        Portal_User
		        Account_ID
		        Action
		        Zoho_Module
		        Result
		    )
		}

		list Config_Stage_Map_List
		{
		    displayName = "Config Stage Map List"
		    show all rows from Config_Stage_Map
		    (
		        CRM_Stage_Value
		        Client_Label_EN
		        Client_Label_AR
		        Dashboard_Group
		        Who_Acts
		        Sort_Order
		    )
		}

		list Config_Strings_List
