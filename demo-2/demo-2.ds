	customize
	{
	    layout
	    {
	        theme = "theme_1"
	    }
	    font = "Inter"
	    color options
	    {
	        name = "Primary"
	        brand color = "#006250"
	        type = "custom"
	        dark mode color = "#004336"
	    }
	    logo
	    {
	        preference = "app_icon"
	    }
	}
	}

