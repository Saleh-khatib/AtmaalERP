		    (
		        type = text
		        displayname = "String Key"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Text_EN
		    (
		        type = text
		        displayname = "Text (English)"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Text_AR
		    (
		        type = text
		        displayname = "Text (Arabic)"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Error_Log
		{
		    title
		    {
		        displayname = "Error Log"
		        on add = "Add Error Log"
		        on edit = "Edit Error Log"
		    }
		
		    Error_Details
		    (
		        type = section
		        displayname = "Error Details"
		        row = 1
		        column = 0
		    )
		    must have Event_Time
		    (
		        type = datetime
		        displayname = "Event Time"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Function_Name
		    (
		        type = text
		        displayname = "Function Name"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Message
		    (
		        type = textarea
		        displayname = "Message"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Reference
		    (
		        type = text
		        displayname = "Reference"
		        row = 1
		        column = 2
		        width = medium
		    )
		
		
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Notification
		{
		    title
		    {
		        displayname = "Notification"
		        on add = "Add Notification"
		        on edit = "Edit Notification"
		    }
		
		    Notification_Details
		    (
		        type = section
		        displayname = "Notification Details"
		        row = 1
		        column = 0
		    )
		    must have Portal_User
		    (
		        type = picklist
		        displayname = "Portal User"
		        values = Portal_User.ID
		        displayformat = [Full_Name]
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Account
		    (
		        type = picklist
		        displayname = "Account"
		        values = Account.ID
		        displayformat = [Account_Name]
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Event_Type
		    (
		        type = picklist
		        displayname = "Event Type"
		        values = {"Request_Submitted", "Status_Changed", "Info_Required", "Proposal_Available", "Approval_Required", "Signature_Required", "PO_Required", "Request_Completed", "Ticket_Updated"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Reference
		    (
		        type = text
		        displayname = "Reference"
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Content
		    (
		        type = section
		        displayname = "Content"
		        row = 2
		        column = 0
		        visibility = true
		    )
		    must have Title_EN
		    (
		        type = text
		        displayname = "Title (English)"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Title_AR
		    (
		        type = text
		        displayname = "Title (Arabic)"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Body_EN
		    (
		        type = textarea
		        displayname = "Body (English)"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Body_AR
		    (
		        type = textarea
		        displayname = "Body (Arabic)"
		        row = 2
		        column = 2
		        width = medium
		    )
		
		    Status_And_Timing
		    (
		        type = section
		        displayname = "Status and Timing"
		        row = 3
		        column = 0
		        visibility = true
		    )
		    must have Created_Time
		    (
		        type = datetime
		        displayname = "Created Time"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Read
		    (
		        type = checkbox
		        displayname = "Read"
		        row = 3
		        column = 2
		        width = medium
		    )
		
		
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Portal_User
		{
		    title
		    {
		        displayname = "Portal User"
		        on add = "Add Portal User"
		        on edit = "Edit Portal User"
		    }
		
		    User_Details
		    (
		        type = section
		        displayname = "User Details"
		        row = 1
		        column = 0
		    )
		    must have unique Login_Email
		    (
		        type = email
		        displayname = "Login Email"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Full_Name
		    (
		        type = text
		        displayname = "Full Name"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Phone
		    (
		        type = phonenumber
		        displayname = "Phone"
		        row = 1
		        column = 1
		        width = medium
		    )
		    CRM_Contact_ID
		    (
		        type = text
		        displayname = "CRM Contact ID"
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Account_Assignment
		    (
		        type = section
		        displayname = "Account Assignment"
		        row = 2
		        column = 0
		        visibility = true
		    )
		    must have Account
		    (
		        type = picklist
		        displayname = "Account"
		        values = Account.ID
		        displayformat = [Account_Name]
		        row = 2
		        column = 1
		        width = medium
		    )
		    Account_ID
		    (
		        type = text
		        displayname = "Account ID"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Account_Name
		    (
		        type = text
		        displayname = "Account Name"
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Role_And_Preferences
		    (
		        type = section
		        displayname = "Role and Preferences"
		        row = 3
		        column = 0
		        visibility = true
		    )
		    must have Role
		    (
		        type = picklist
		        displayname = "Role"
		        values = {"Requester", "Approver", "Viewer"}
		        row = 3
		        column = 1
		        width = medium
		    )
		    must have Language
		    (
		        type = picklist
		        displayname = "Language"
		        values = {"English", "Arabic"}
		        row = 3
		        column = 2
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Email_Notifications
		    (
		        type = checkbox
		        displayname = "Email Notifications"
		        row = 3
		        column = 2
		        width = medium
		    )
		
		
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

