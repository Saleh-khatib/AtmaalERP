form Config_Strings
{
    title
    {
        displayname = "Config Strings"
        on add = "Add UI String"
        on edit = "Edit UI String"
    }

    String_Details
    (
        type = section
        displayname = "String Details"
        row = 1
        column = 0
    )
    must have unique String_Key
    (
        type = text
        displayname = "String Key"
        row = 1
        column = 1
        width = medium
    )
    must have Text_EN
    (
        type = text
        displayname = "Text (English)"
        row = 1
        column = 2
        width = medium
    )
    must have Text_AR
    (
        type = text
        displayname = "Text (Arabic)"
        row = 1
        column = 1
        width = medium
    )



    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
