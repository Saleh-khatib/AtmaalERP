form Audit_Log
{
    title
    {
        displayname = "Audit Log"
        on add = "Add Audit Log"
        on edit = "Edit Audit Log"
    }

    Audit_Details
    (
        type = section
        displayname = "Audit Details"
        row = 1
        column = 0
    )
    must have Event_Time
    (
        type = datetime
        displayname = "Event Time"
        row = 1
        column = 1
        width = medium
    )
    Portal_User
    (
        type = picklist
        displayname = "Portal User"
        values = Portal_User.ID
        displayformat = [Full_Name]
        row = 1
        column = 2
        width = medium
    )
    must have Account_ID
    (
        type = text
        displayname = "Account ID"
        row = 1
        column = 1
        width = medium
    )
    must have Action
    (
        type = text
        displayname = "Action"
        row = 1
        column = 2
        width = medium
    )

    Zoho_Module_Info
    (
        type = section
        displayname = "Zoho Module Information"
        row = 2
        column = 0
        visibility = true
    )
    Zoho_Module
    (
        type = text
        displayname = "Zoho Module"
        row = 2
        column = 1
        width = medium
    )
    Zoho_Record_ID
    (
        type = text
        displayname = "Zoho Record ID"
        row = 2
        column = 2
        width = medium
    )
    Result
    (
        type = text
        displayname = "Result"
        row = 2
        column = 1
        width = medium
    )
    Error_Text
    (
        type = textarea
        displayname = "Error Text"
        row = 2
        column = 2
        width = medium
    )



    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
