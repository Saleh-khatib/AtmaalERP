report Request_Index_List
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Reference
                    Account
                    Service_Name
                    Client_Label
                    Stage
                    Dashboard_Group
                    Action_Required
                    Last_Modified
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Reference
                    Account
                    Service_Name
                    Client_Label
                    Stage
                    Dashboard_Group
                    Action_Required
                    Last_Modified
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
