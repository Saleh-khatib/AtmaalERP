form Error_Log
{
    title
    {
        displayname = "Error Log"
        on add = "Add Error Log"
        on edit = "Edit Error Log"
    }

    Error_Details
    (
        type = section
        displayname = "Error Details"
        row = 1
        column = 0
    )
    must have Event_Time
    (
        type = datetime
        displayname = "Event Time"
        row = 1
        column = 1
        width = medium
    )
    must have Function_Name
    (
        type = text
        displayname = "Function Name"
        row = 1
        column = 2
        width = medium
    )
    must have Message
    (
        type = textarea
        displayname = "Message"
        row = 1
        column = 1
        width = medium
    )
    Reference
    (
        type = text
        displayname = "Reference"
        row = 1
        column = 2
        width = medium
    )



    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
