form Account
{
    title
    {
        displayname = "Account"
        on add = "Add Account"
        on edit = "Edit Account"
    }

    Account_Details
    (
        type = section
        displayname = "Account Details"
        row = 1
        column = 0
    )
    must have unique Account_ID
    (
        type = text
        displayname = "Account ID"
        row = 1
        column = 1
        width = medium
    )
    must have Account_Name
    (
        type = text
        displayname = "Account Name"
        row = 1
        column = 2
        width = medium
    )



    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
