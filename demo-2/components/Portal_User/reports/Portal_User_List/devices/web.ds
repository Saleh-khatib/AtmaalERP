report Portal_User_List
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Login_Email
                    Full_Name
                    Account
                    Role
                    Active
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Login_Email
                    Full_Name
                    Account
                    Role
                    Active
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
