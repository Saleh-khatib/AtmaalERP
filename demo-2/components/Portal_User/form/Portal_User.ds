form Portal_User
{
    title
    {
        displayname = "Portal User"
        on add = "Add Portal User"
        on edit = "Edit Portal User"
    }

    User_Details
    (
        type = section
        displayname = "User Details"
        row = 1
        column = 0
    )
    must have unique Login_Email
    (
        type = email
        displayname = "Login Email"
        row = 1
        column = 1
        width = medium
    )
    must have Full_Name
    (
        type = text
        displayname = "Full Name"
        row = 1
        column = 2
        width = medium
    )
    Phone
    (
        type = phonenumber
        displayname = "Phone"
        row = 1
        column = 1
        width = medium
    )
    CRM_Contact_ID
    (
        type = text
        displayname = "CRM Contact ID"
        row = 1
        column = 2
        width = medium
    )

    Account_Assignment
    (
        type = section
        displayname = "Account Assignment"
        row = 2
        column = 0
        visibility = true
    )
    must have Account
    (
        type = picklist
        displayname = "Account"
        values = Account.ID
        displayformat = [Account_Name]
        row = 2
        column = 1
        width = medium
    )
    Account_ID
    (
        type = text
        displayname = "Account ID"
        row = 2
        column = 2
        width = medium
    )
    Account_Name
    (
        type = text
        displayname = "Account Name"
        row = 2
        column = 1
        width = medium
    )

    Role_And_Preferences
    (
        type = section
        displayname = "Role and Preferences"
        row = 3
        column = 0
        visibility = true
    )
    must have Role
    (
        type = picklist
        displayname = "Role"
        values = {"Requester", "Approver", "Viewer"}
        row = 3
        column = 1
        width = medium
    )
    must have Language
    (
        type = picklist
        displayname = "Language"
        values = {"English", "Arabic"}
        row = 3
        column = 2
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        row = 3
        column = 1
        width = medium
    )
    Email_Notifications
    (
        type = checkbox
        displayname = "Email Notifications"
        row = 3
        column = 2
        width = medium
    )



    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
